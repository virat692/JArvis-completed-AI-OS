{
  "defaultProvider": "gemini",
  "fallbackOrder": ["openrouter", "nemotron"],
  "taskRouting": {
    "generalChat": "gemini",
    "complexReasoning": "nemotron",
    "coding": "gemini",
    "debugging": "gemini",
    "vision": "gemini",
    "research": "gemini",
    "translation": "gemini"
  },
  "globalSettings": {
    "temperature": 0.7,
    "maxTokens": 4096,
    "timeoutMs": 30000,
    "maxRetries": 3,
    "enableStreaming": true,
    "enableCaching": true
  },
  "providers": {
    "gemini": {
      "id": "gemini",
      "name": "Google Gemini 3.6 Flash",
      "enabled": true,
      "priority": 1,
      "model": "gemini-3.6-flash",
      "alternativeModels": ["gemini-2.5-pro", "gemini-2.5-flash"],
      "apiBaseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "envKey": "GEMINI_API_KEY",
      "contextWindow": 1000000,
      "supportsReasoning": true
    },
    "nemotron": {
      "id": "nemotron",
      "name": "NVIDIA Nemotron Ultra",
      "enabled": true,
      "priority": 2,
      "model": "nvidia/nemotron-4-340b-instruct",
      "alternativeModels": ["nvidia/nemotron-mini-4b-instruct"],
      "apiBaseUrl": "https://openrouter.ai/api/v1",
      "envKey": "NEMOTRON_API_KEY",
      "contextWindow": 128000,
      "supportsReasoning": true
    },
    "openrouter": {
      "id": "openrouter",
      "name": "OpenRouter Failover",
      "enabled": true,
      "priority": 3,
      "model": "google/gemini-2.0-flash-lite-001",
      "alternativeModels": ["meta-llama/llama-3.3-70b-instruct", "qwen/qwen-2.5-72b-instruct"],
      "apiBaseUrl": "https://openrouter.ai/api/v1",
      "envKey": "OPENROUTER_API_KEY",
      "contextWindow": 128000,
      "supportsReasoning": true
    }
  }
}
