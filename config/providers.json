{
  "defaultProvider": "gemini",
  "fallbackOrder": ["nemotron", "openai", "claude", "deepseek", "local"],
  "taskRouting": {
    "generalChat": "gemini",
    "complexReasoning": "nemotron",
    "coding": "nemotron",
    "debugging": "nemotron",
    "vision": "gemini",
    "research": "claude",
    "translation": "gemini",
    "localOffline": "local"
  },
  "globalSettings": {
    "temperature": 0.7,
    "maxTokens": 4096,
    "timeoutMs": 30000,
    "maxRetries": 3,
    "enableStreaming": true,
    "enableCaching": true
  },
  "providers": {
    "nemotron": {
      "id": "nemotron",
      "name": "NVIDIA Nemotron Ultra",
      "enabled": true,
      "priority": 1,
      "model": "nvidia/nemotron-4-340b-instruct",
      "alternativeModels": ["nvidia/nemotron-3-8b-instruct", "nvidia/llama-3.1-nemotron-70b-instruct"],
      "apiBaseUrl": "https://openrouter.ai/api/v1",
      "envKey": "NEMOTRON_API_KEY",
      "contextWindow": 128000,
      "supportsReasoning": true
    },
    "gemini": {
      "id": "gemini",
      "name": "Google Gemini 3.6 Flash",
      "enabled": true,
      "priority": 2,
      "model": "gemini-3.6-flash",
      "alternativeModels": ["gemini-3.1-pro-preview"],
      "apiBaseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "envKey": "GEMINI_API_KEY",
      "contextWindow": 1000000,
      "supportsReasoning": true
    },
    "openai": {
      "id": "openai",
      "name": "OpenAI GPT-4o / o1",
      "enabled": true,
      "priority": 3,
      "model": "gpt-4o",
      "alternativeModels": ["gpt-4o-mini", "o1-preview"],
      "apiBaseUrl": "https://api.openai.com/v1",
      "envKey": "OPENAI_API_KEY",
      "contextWindow": 128000,
      "supportsReasoning": true
    },
    "claude": {
      "id": "claude",
      "name": "Anthropic Claude 3.5 Sonnet",
      "enabled": true,
      "priority": 4,
      "model": "claude-3-5-sonnet-20241022",
      "alternativeModels": ["claude-3-5-haiku-20241022"],
      "apiBaseUrl": "https://api.anthropic.com/v1",
      "envKey": "ANTHROPIC_API_KEY",
      "contextWindow": 200000,
      "supportsReasoning": true
    },
    "deepseek": {
      "id": "deepseek",
      "name": "DeepSeek V3 / R1",
      "enabled": true,
      "priority": 5,
      "model": "deepseek-ai/deepseek-r1",
      "alternativeModels": ["deepseek-ai/deepseek-chat"],
      "apiBaseUrl": "https://openrouter.ai/api/v1",
      "envKey": "DEEPSEEK_API_KEY",
      "contextWindow": 64000,
      "supportsReasoning": true
    },
    "local": {
      "id": "local",
      "name": "Local LLM (Ollama)",
      "enabled": false,
      "priority": 6,
      "model": "llama3.2",
      "alternativeModels": ["mistral", "qwen2.5-coder"],
      "apiBaseUrl": "http://localhost:11434/v1",
      "envKey": "LOCAL_LLM_URL",
      "contextWindow": 32000,
      "supportsReasoning": false
    }
  }
}
